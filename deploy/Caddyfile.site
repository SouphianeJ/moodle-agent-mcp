# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-2DZWPzk+140qPS1OBztcb7YapeOs279pqnVS6aj6qF4=' 'sha256-2Zn/SR+rxTzz7VcX9D4ndgafSfw+wOkC+g92ejrgFlY=' 'sha256-5XteBfH4chaS1REWZiTMR/hPGvIOAodB5ST5OyXqemA=' 'sha256-9vqGbZQUF1atswX64Jl/ghMmUj7cPcrhqfqVZzfN4CY=' 'sha256-BLNtOkJL92fvecpdhKhWZWsOnydghbIwYam4RbdGIp8=' 'sha256-C4irU/HVqfIOsrcgFT+J0eocBIMI48qhHwdmuXqJZ7o=' 'sha256-DF4ddR84AacE3miBTdS/8JQmUS4H64ZRQSd0ireKNVQ=' 'sha256-Gl9oJTYE0c0l0A1qoI3/a3zosfS0RVIaU7bfGTN26hk=' 'sha256-I+pGJa6YyTjstAQHPP+X3ayuteGJSX1OEFywehFFJiY=' 'sha256-KkYOXMR/fiZv5qE4TE11dwX66LMaaq0Sl3E5lnaubGo=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-NW1qsPu/ME72Cz/0ahkq8uxv9I0RhczVxKXhbGrwgFI=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-Qcd3yiPsSD1ymJfwpl/Rfu7frB91q2sXPZTflrLNCUA=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-ZAZkm2RGgMHmrigUTLsUDrsnFGryM7zaK7+HgSl90eE=' 'sha256-bBmxEzk8RrCtOSQ6t0QniGKTFn1OzC4l2chk77Gzli8=' 'sha256-dZImv8tKqp6BlrP89SRuReRn7JN4AQUoLqoHB0BeI28=' 'sha256-fF7rEw12KHi9x7w71up+bf3T6xBdsxpGohQdmh6Sa/A=' 'sha256-flbOl28Xy8lw13jJw45mkuuXOgabvHRrAISywObXIt0=' 'sha256-k4Xja+YojTL0q58eNqUHXgAofj1BjgcAtYW5FyTkv6M=' 'sha256-o61C9pc/j1mlyuKkKdRcfbZV5Z0jJmdx2hg9Wodr2yk=' 'sha256-sMgt7T6Y0hr9WFYgTNIKz/t740mM9haEFywqWU89lKQ=' 'sha256-vQc++p6Ze84vuYhGLYPxDAsORtZUImb8mzQiv/NV04U=' 'sha256-veJPSZZuOIGdcDENoIP6r6UNKdnDabvmK6ziixmnj8o='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
