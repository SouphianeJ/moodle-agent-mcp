# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-0Tbnso5WiTH57pV5PpUFmUdxXwFy3CGzHIwq3KWUNZE=' 'sha256-1cpbyMEegj/2N36JZJyyNKQBD2pyjkxmSOdKdJHz0UE=' 'sha256-22fj0utD/Qs8iSIa6+AcNlXV3KOvLRdYtkK8XSc2i6E=' 'sha256-6Ozqi0vD/Hg5zAZ19ZDNi5vA/b6LrmAA+124lPRSkVI=' 'sha256-7P9G+v+JanNULM4dujGeN/2Q3eWwOt4oOHOBzGutF8A=' 'sha256-CwW0AEU7PCJUjaN/rMlQoXSVXd3EEU/ViRPABhl2K8c=' 'sha256-HTIB8W15LD3Mp9oCKGvdP9cpBbUJ4jZ0owS+wcgKcbw=' 'sha256-Is0mGpOGEBiDlXG/STrcAbd9cp8grzB25VC93h9+gpE=' 'sha256-L2d2o+5GZd+UWMSQ+W/fX3OtmsTKQvsSMvF75ZzSb9Y=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-RfwipQbWSm3X6/r2ecyBYgnp9nQpLY3MhfPVpo2fH3I=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-U25FPyOgMXyw16gcaluxk26eDZ3zKUwzjesUfd3W8AA=' 'sha256-Up+tGOQoh5QqfR90rLI8ZuGa2S0b5Z++3woEscpLIG0=' 'sha256-W69VO0R9yJAIb8o6y6Aj8eVk7RfxDVwHGrr8QpNB2cg=' 'sha256-ataQwWGF7nkd8wyrTmb9CX+1hW+Qf8a/BbCVqPIeDEQ=' 'sha256-b2EYWEMI3c3mCg8w+tz0Zq/yvKH6bmS1/HCnWGDePQM=' 'sha256-bKg8XUsabxL/vU1zOi355WzUoujhZC3phBy9P1Z5BMs=' 'sha256-dScIEFCdAxuoH81UeuOybsLpZQzG7pBbDhiMVP6LyXU=' 'sha256-ht10B2QVS6bVewq8itOGCrQy0+tKabS09WgB4JasMYI=' 'sha256-m/sWnlSWgjs/eloaKAW1FC5cr+R5IsVMDhd5oouBOZs=' 'sha256-os9XFMGiIIMvedjwAmatffInXzAGoreQY1lRinzQTfk=' 'sha256-u9JY7VInu49mQvEVbYbOHVOi27o60fGc0uhX8PmblI4=' 'sha256-vWl5QHAEQJc+7saSvSbeDkL3xXh3akhGIrybKzZNR6E='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
