# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-5phi7PWDWcz3MuU38mtxihpdLM8IlM81cFy4it2S63g=' 'sha256-65dMq7Fty+fUPc9+6swliCxh0uzy3CdZYpIpAcNuVIc=' 'sha256-8iCEaGDHzG8JC/tdwTmDBx/1or2+K/ggFumovvRBdZY=' 'sha256-DQLcNk3jgh8Ujwm0j7kjLvo4UqlEp13TZoMtWR20TYs=' 'sha256-DW1ypV79B4TgSGAKcjB+e5PH09tCmqKwcr4nj/cpCZI=' 'sha256-EVasn2qsLVzVSFBQxsKGFdUok8aNOzGkKW/ecq4Em+o=' 'sha256-GPiVl6JX5QZ/ph+3Rje3baCO2BEhgPyM4ibtB7Fy9Jw=' 'sha256-LNabqXtyNwWFUZYX4IzQyQPhl4HFWGRWbt5XKPmHLkk=' 'sha256-LWE5ekYl/OazMcQQDwh+VZ2OTMqUPbNxWUuJtyQu4Zc=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-NuOr0Dzbgpj/rXSFaoYFynENvCn52WPFnUWG4TsZVMs=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-RaJqoX9OhbovII40fHGadyIAOB3/mcMEs+KIpjG/Q+k=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-T89SvF8WxKVU4TBsSl3X8qcPKSlhj9rAY9+DrGr3MUY=' 'sha256-VmPnwnKMCxl6R8eR2U0I6/LtrY+RwrOghh6H9JzsscM=' 'sha256-WBJloqBs1Exz6NLeoTgLpxVGhu39zONe48snYDQ16uI=' 'sha256-WVN36+b5xxJSQC1+a+YMvnJJfy5Dl+Qq7tl2cmUgYGU=' 'sha256-ZC1rXyUStloOBpMzf26DhveIlg81YRAGRXbIJe8uG7A=' 'sha256-ljeiDeS5XPZRVTPXuCfjSBxUdEKHLJ0egrAhAvIbX7I=' 'sha256-oQ2oFKafl9ddB2yVcDQuJvCzuswHOYria2k6+R+xzrA=' 'sha256-rJppIj8nVhvK7bP4aHydRL9qq33oOsVqjYS5dB+S6P8=' 'sha256-sOLgnNYlTeY4ErXsJKEXK28ik9ZbBK/dbQ2F91ClAzk=' 'sha256-vG/8bdr/MoSeHknltqrJvlgqQPDmgUqic1CRxvS4KLg=' 'sha256-wyBMtQMnSCgPAv2x7KFy/GCLVJ4dkT7iw+ExW8zRU2M=' 'sha256-xTwi3HWpF2nMIeZ1MM7gwFXxXq6YOnWYctknrFBuwJ8=' 'sha256-xegjql6dNql1PAfXTCGJPiZiHNmc1DpGf1qhpoDBj9c='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
