# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/fzjqsKu408UhJPRlzujfedXMjiXauiXRud8VEWIDuA=' 'sha256-0UqH7vQS78+g6ghdnpqE1PM/nDuYtLJV0pcWJiVqnWY=' 'sha256-0pqtOtRylgxit0lP5FYKQLxZoYxDyAbVSFmwvgY5q7w=' 'sha256-4n99rsECssUmVKF+YOCTDNRkeyXwU+PWK1m1rpQL8i0=' 'sha256-5kQbgOkaiy2en4q6dgNEbHtaL9nm5GRNZjIHMCNwFYc=' 'sha256-F97v6NGkDWlEbcfoa7UwG1kVz6lWSluCIXtSKZWhCJc=' 'sha256-LH31a+6hD9LlsMhrpsAKfWNdQS50+Z6Lv4Yv1sh4D/0=' 'sha256-LIMj0wf4XFJAtcgHANN+7peL2oY3lmOgOjLAt6L/AUw=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-NGPDzmzD5vCDvIcFM0gK7O146gYE3BCuUaQ9cENyzHo=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-Orv0XyVbe9hRJ0HsHsp1JvMtJPt3bJrvRqooOIKL/Yk=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-VZJUQU9zAIVrW1z4Sx2hEhoSAnfLwQoehUqvweJqeBo=' 'sha256-WGs8g7O2gw9JU1i8XsfVSeXwieLVjND+pjL0VKQf5XY=' 'sha256-eo13Te82irnZZun3eDcpxp2ZkTvuGjwBqwUX2kxED7E=' 'sha256-esAInTA7JXa4+84qaAy2/QO9ak3W1spXCDCzS2at1nw=' 'sha256-iT5AFCDjLBLCqmgsD2CxG6i4kbUJyQpP0AuENEw5Z3o=' 'sha256-mejFvy5FHPP/7+isZjkqIjCpqf53hzl0G9x5ipRh58Q=' 'sha256-pck+iSg3Mt2Q4jeQlM/SR1JobUONzhKcdFFTF2zRxv4=' 'sha256-puooo3NcH4cnJ4kiR1tU9Pcf5WXJingraVlNgru/BLU=' 'sha256-r2CZ91AqDYwGe0orhx1mf5sxq56AsgJJ5s7UfARjQVs=' 'sha256-wwqOkBspmSknBsTiZ1ymhQGGczsYLxMbQW1NbxdMeQE=' 'sha256-xAefoehPy6i4GwbGdFH4/auchkLKcgZEQC1h4uxgq8s=' 'sha256-z8WZ8+7srF+rH/KO/+V3KZRJMIiSxZuBWZfnRe92FEA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
