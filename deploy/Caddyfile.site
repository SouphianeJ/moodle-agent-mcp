# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/BCRSGvamVFlcYUNuf9VGyTIN3KZ1YXni6xyWjFkcRg=' 'sha256-/TpqQMEw9jdlBKZlMjK0gtJNOR7Uw6o5RjJ3tXenBGE=' 'sha256-/uFvWS+x/cqiWhEXZIJBW02TuwI6rPPux5qIcxdZ2QY=' 'sha256-3HSRmB8Xsd9dXY92muXpjzeZ/fQtg5qVkME+uVAMDIo=' 'sha256-43A6Gf5Qu1sck9mj7zxRQgHjVQ2Myh5+Q+RnEwWW1ro=' 'sha256-9m4KWem0DGMxk8tM4/873ajhrQf1RWTBgt/FQXUqEoc=' 'sha256-DNUgKdDM1FXev1KPs8pCcMr1dpyfbR6Zj/dv9BQOjvA=' 'sha256-DPO4uE+1cYJ5uiOkQ6qRErvwB4xjdBkriVWhAQNzWy0=' 'sha256-EL0UaVb52Ckj8CLdW5+6xOOQQBblmzIxhcs/pdY/dQQ=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-M2zF0UDvo3xcGHEfEDO/zcURMRzsPPe8R8IlacCqOtg=' 'sha256-N6w3TXaSFROh25hB9Y441emZ3Yci5hOIggFdq41QvZg=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-OIVobWZ1yhnLiwaJrE5Uib72qQ1AtVyVmdMeywGO3oY=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-Yek/4YoZ6JO3U8f2jW/Kcfzszyuq72MGsaVu5UPcmL0=' 'sha256-Zi2Sc6aK2vGcUqAbfGlNNSThzqPwdgVbQD9cRhESG4E=' 'sha256-bRgNbdSYzUvEobyhS4sC0UDhfqZpgGgtDz/ifcVLQXs=' 'sha256-gmdfZiP4+k6JtrjybfyVIehzrkIt0OU3S+55yst9wzg=' 'sha256-ieE6Gg1YfWtJVMmWvtrSAFfri1DdlpX0ng6Zy4X3nyo=' 'sha256-l9N7lviJ8vvbzw5Q7NbSLNUCmT4leKuF7RpWulA2v1Y=' 'sha256-pCBF618RKmXMkZDVCKflhTSQPeYZmFQmMRIcu2Ev8BI=' 'sha256-v766tefLNwRnVoufYDbj2U/fGJaFk7rqmGzOQctQ4xk=' 'sha256-xtVRHACE/nXvxzPMFbzj5YQjl6q46bH0DYfBXOHx+zs=' 'sha256-zP0tdvGA1zfH6I1F69b8iuW4ELevr0wal/dHl+8YT9o='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
