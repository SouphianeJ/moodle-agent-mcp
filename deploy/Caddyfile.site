# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+rp+aYe4V6s7ijxnj5zLKUqkMJjjBts9RsjI80hu+7Y=' 'sha256-/80oak4OAKYkO0r12cnJehPAESDw4uvHonp5pPKr9qM=' 'sha256-1FIoOVUCCWfwtpoe7WytNAWk4jcoG7MiXF+EfMHOb8k=' 'sha256-9kU/q22cPEzxWG9IpbdjOvGhUtCQ0iwsi1T/dGj1sn0=' 'sha256-I4wc69F/hUsELJ9wBgl/lQd1mSaIfLXdF9+pLHTnUEQ=' 'sha256-J17FJxr8feh38zxbnF9Qz0Hq+RRws+arkmKRF/GqlOE=' 'sha256-L+kr/xYMQmRr925SC4L8IzrF+5lHBSML7wlD7J8kkEg=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-MRsJhwZXlhDi+zl5GX6qaaYbMoglONuHBnWckUhYVYw=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-SUtGwJOAWGg2nRD+YidEP/GNhHnCFNcoKd+Lvn8AqEw=' 'sha256-UwfVuJya22k1HrNmkwgmKgRqc6c5NGxqRH0y2gub1uc=' 'sha256-Wyc/pB5BNJQd+sP7YAgIQCqzDmU0Bi+3vsGNiSUoVsE=' 'sha256-XOC9yKCsV6f+VDKzGsTAlwNW0nOW4gR18Stjhl0FGzM=' 'sha256-bZCJshR1kXLW/A0pPFjmkHTGbJeQkNOPVoYEwWdm2Qo=' 'sha256-cq/i+AocUlSSDcuYOcDgjNx9VMBgDzq/c8sRfFrnq+8=' 'sha256-iLvVamdiV04Anm3IhpTjKjS1Pqmh7v/wo6Pm22heaPA=' 'sha256-j58E4wt6Zk7M1QJGQZL6pUnOLA+7LukZ1ajK9d7pKLw=' 'sha256-kPMW4u+dhYG+quWijqwmYqvG4x5DzhlhktUDNFe/0j8=' 'sha256-lNZ6CukfEg7qb/2poB71PZ71oQXH7yq+Iv69sINVrIQ=' 'sha256-mp6osZM7DhdTtdaLSdsy/1hi7YFaOlwuq2ogs2A04WE=' 'sha256-pN6f0VvEJGPe1Nk1+5MjPhy2iyObLVhqVRJ7nhs/KNM=' 'sha256-uIxD+NcAJl5437M1f59Wl60bq4yc1oGOlfsEiYcaAno=' 'sha256-xM+OQpwNmZUxjZcPW03e/sL6i6TW63+89XKO8RlCkTk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
