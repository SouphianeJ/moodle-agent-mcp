# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-3k8GFEfxCnOnJZSF/fLIABARspgUDCeI+706dCZQ2zo=' 'sha256-43kOajKRlwGsv+TTRh0SrMWwMIvEasf4jdVYoVjpQoI=' 'sha256-8n29cW0ehZ+tqEmIHM4w1YKJ+atfAgg7vIhAAd3cxWE=' 'sha256-A/3LA3w1/2hxrm5rwxD9H7p4FBTSdBO80KHV7B//wWY=' 'sha256-AKpc0flFr7Hetdec84vBnHoYmXWOvW9D9JT7rSyX9U8=' 'sha256-APvJcDEONuGIo2NGfDjJt0HYK5mq/EwPLN9ovDLQo3E=' 'sha256-Kp3IBqHf1TdwH8K7YWmRqN58GBBQnarL5XFVInZ/DTI=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-NcrjMSy6fCHZLuBwETpOG8G0mNhU+rn72YbbeXUp5/k=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-WC+PFIqCPLkrLblfle2Pcgf5AByy9qTYeIlCn9GbOZA=' 'sha256-ZVpWyQ+fwqhna6qpt3ht0SM4BE38ytbrM2IGYYCZcBY=' 'sha256-a2C0qsO/CArjNgD+N2u5NEkAmGEGfxcfbfiH8b+pNZU=' 'sha256-a8Z0BmWX4edtr24oBTFoR3+mZ63QkVjNcT2hf+jGTIA=' 'sha256-ayPl9vUh1r9FyUpcqbfl/ppxe1khenMT1n62n13H2/I=' 'sha256-dZ7DlINR16XVJ/47FB/hs6OCfKlhGCTEdP/PrINrzF0=' 'sha256-fhQQBaK7cGxv3vfEiW7tx4p/sWfTyJalXGHqG2X0g9U=' 'sha256-fwgkMaCSR8mF+pJt9GTRe0H3psxpugMwFfOiQYK3asU=' 'sha256-gIuAIM0naGYAegoGK87Cz00jMPEPNSsnyXDclUaagaQ=' 'sha256-ghMdsfhwNlrEnYC4uH8EX5CHAcDC6e0QxFIJuAOWtpo=' 'sha256-mfmkY3Y3GuoO6f+PVZteJasQNNqDFjj7BjQd6LlZJ1A=' 'sha256-n5LYrClvaEZSI63pJa8MXijE9i47TUtU9V9/SZ8Kmj0=' 'sha256-p1dJyqYpDRvyBlulL+w+1Cj4tUK29cpK5aWDIV3nicc=' 'sha256-u4AmQyV8ZKtUZOqkwScGfwtTuCcmzbePYMx5jbqLhlw=' 'sha256-uGnKu6hYlLNxsy7vK4NT22rEgVyeoicddPhT69oTIiI=' 'sha256-ymcd2Sd52HeNmRZdBQsZZjTEr9RFXhTIDDvoGNl8PUc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
