# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-0GmrU9QMXxFmIpD57DWGNVLpEX2dUhSwf2UBz2WLoxM=' 'sha256-1XkOpyfNJ2Mp5xlNexxzw1gSZRhnfEPHi264E11yEoo=' 'sha256-2t6c1Upm4h2QgYCm8FE9E9zJErl/4AbHJGhQgdiaCBI=' 'sha256-2zl+MRa+WlF7eetSx1sib0eFb2w+3a81T7i5YaPwOmE=' 'sha256-4zNoZxGCnQoHHlTrE5WU7NdOnF+LxQE2vcdOIaToZmk=' 'sha256-5/DIZLYBlsvW4g62Mn+AWKYoQWqjHAXVVoLtPdaA98c=' 'sha256-C2bl/oZ0S0rvlhVxeLfSWlpq3uF7qPUI1IjiZn1YGQw=' 'sha256-EGV31p+ZsiRhO1UxPYWw2dq9iXBXR1PIq5InuNOWI/o=' 'sha256-ESOYA4J7WF2qW53Mm/F/RfOx93sb3lFryFqy/8gRuhA=' 'sha256-EUO9wkPAl8Z62UmR6Th5s93pxXaf69yl8idN9P1+11k=' 'sha256-F074ISeIJ8Qxdklz+k5mn6gA6vzlv7iPZLbsS327+MQ=' 'sha256-L04i5+jVT+BwLoT/D9zT9m8XV3T56vfI4nLCXSEoELU=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-OCbezbfmK+MT08MvCKl5FMCq6q1B4U9sdCDvP9ZaWvI=' 'sha256-QMBrxW4kefHZhsfp42m3PUhTaqCNfFVMUUhROK/xAiM=' 'sha256-Ra/ih2UjAt0KK3TU37Ikvn+IjKP/dC8fkNX5GKEvLi4=' 'sha256-SFDk6CybheOfmY3V/OV+xmlyixUmj5roBgHWZoxzyPY=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-XKM8lHTFwZSDN6zdMfI32kR+kDsD7RqvrB9MnvLJ4v8=' 'sha256-ZkoQPy4PSzlffQ/KGNHl0H4dQMMKZEm5oJdH9QeMQsY=' 'sha256-ddJF0Rse/5q5D/J081qB9LBmUVyNSosj9J6G19vGMDk=' 'sha256-fBU+2DNrzYNeb4RGahWLoL4GORejvd7AbSDcQbo/HkI=' 'sha256-rvzpMSY7oTMzsA6ae39gSqcXe1dhH+kp7cyfGdWY5hU=' 'sha256-sA3+Jb1AmLg3LbiUCj4E58jLKaTSi5VCALcAH7qZ6GA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
