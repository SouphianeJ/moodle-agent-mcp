# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-0G0sOrNMygDbob8pQK304ekB4oa5V0deWxRBuLiubkw=' 'sha256-4k+vGVZfryG7zB2UaJbwui+9KJksZkqm/QiAC+ezDu4=' 'sha256-5Em62Wjg4HwcbidnAWrWcmxtiPhr6prNfW6Z20jgM/o=' 'sha256-8b0cL6QPXDYexLjvgqSARPhGRoDbqJDNhwFiumGHRfQ=' 'sha256-BTLxwbxWQwi2MPWbR8LmG4bUm1NibtWUjSD2+Q2gwSk=' 'sha256-BvPhNk7e/Rw3zqJivtJEHbq0zDzGyboHuOVg4tXGUAE=' 'sha256-GIrsRhEY+xm+rE8Y0PqlhJSDtKLmtmUABDbHN9XWaCk=' 'sha256-HdXxTO9X66kiBgzFvxph+pYVaZ5VsT81EjnG2DiZUKY=' 'sha256-I2TdkAZC2dlDgxvmOPl/Z2g3Kt04pOfLXOXbDrBTpTA=' 'sha256-J7JTQ5Wi4MJFoNs0pfcYyFUZ2wJ63gx7fVOQ+lnveNI=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-O8ga8kNJZ3tLCX8AU8x9tll1QzHM+2lWnXu8B0LPT7U=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-V02j+atMiJqzZAb0B8OwpjN0UsCRy2NNRlUu3ug9+hI=' 'sha256-Vp1Y3dQzRhk9NPIzfdt/fmCxINRX7RaqSZOPK3lyRc4=' 'sha256-Vq23vyfBeQ6k3aRe2uW0nwwhXJUH5HgzjRJh6qEW0oE=' 'sha256-ZaFmdHjiJ7UuRZXKdww2gt8OgXwm0KGtUK5rQ4ND++E=' 'sha256-avkwOg29mP7rZCo6jLsnt1bokxYvypU2XJAihyQMI8s=' 'sha256-cPX2Ptcdeq3zmHLE5hf/q5+QnF8N3wGjGfGAVXUZSV8=' 'sha256-fzwpWVXNaV7WDY22C87jaT2FNm1bn5Dl7Ih+5Y47Bcc=' 'sha256-kt3PqgouhItd5E5nIoE4ppsEewl+G7OuS7Qctb9n70Q=' 'sha256-m7jVBsuZJrnrAP0j4RNqNLA/w7h5wz1wPn2UrxX7X1g=' 'sha256-qjjDOhIA6DOKo2oslwgfUKXdxpJjI2OjC1rhTCQ3h8E=' 'sha256-tmjSAAsyOEKm+9oN8tYalckTWnJWLIFkwaBeCH0zghc=' 'sha256-vLpy3EzksFjF2QKWexcg6NOHXrlYzXx/H0WIYV2S2fA=' 'sha256-wcgoHqy91z+Ad3kjX0zdEHQZ3cn2dWnT7hwWFinczPs='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
