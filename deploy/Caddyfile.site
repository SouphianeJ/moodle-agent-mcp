# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/YDb1RoeY4iWQUvujpveIQdCdkAkp3lMOmCJZYCZGKc=' 'sha256-1Djn7PqjRjxw2T093DCvRwnFvAgt6VZGtTp4HnZE58I=' 'sha256-2H0zIeE79sGRwJdE+P9WsGKU5BYBE/I+jgh5xW2T96o=' 'sha256-4rfw0tc2psJ7akhq9cTrC5DrXnfZjeRXsrXdAbC/yHM=' 'sha256-53m7A4coUNlx/xWqLrUdXuZxL8AceTx6oCRfJzkttdM=' 'sha256-9uijMskCFcfHmEh8+N4tq9D5vTxP3TsxKeYW4cwgA3U=' 'sha256-HcmwzvCyrKBYvTy0jQfVfXL5V54ky/A+Jxy/qVtHXmc=' 'sha256-Kd3+C0V7GfGF4wXkEpkY8+bKCtCS2eDw86rPNDQR3xg=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-TNzfMpr/0l7DSAMWavXWq5o7SakkgETEQxp9bZpJzRs=' 'sha256-ZUSwGhShNKicWtXafw/u/ehhD9542KmBZ5TVERAsWWI=' 'sha256-aWH55QzQEYPGBR+pkhgVZegDuTMFEL09SL4S65gRHrM=' 'sha256-cGD0ZRdETx6OQdZAghsUgOj9L4fyt1dilkLn4JFHX5I=' 'sha256-gK84CzhPcBtz324bbn21stxh33pZ7D5MK6xC4qKz97U=' 'sha256-nd1KNV64oQNWKymuEoYZxKADgBvHsAJ1JR+wLaLGimE=' 'sha256-rnB4buxj0y4xcjKJBhz3L5dG4gCsSZD7aZyLGLhOCpI=' 'sha256-tMsqL/muOX16cT4toq4zBpAbom3pWtx/+x461OtgMYo=' 'sha256-tft4OCj7rmv2gAMsMYqpeec+uF4Ywy1TGMGGB2wy+Pg=' 'sha256-troN31p23hP9Lj0lZeLukpjBN5saq4O5bhL9ZGea8uY=' 'sha256-urHjmvipaYncw9lzIfvb1BGBz4WWEonl73lsVayU4Mo=' 'sha256-wozi7NXrFKLMSnAmQrALB15Oc9724heHJHRH2TS/ovg=' 'sha256-xgzz+faFJGza36wTMR5H8KPmqOH9+0Eas/ouNfFTkf4=' 'sha256-yvkDycuABr03tS/dGZVfs8zgziYEMjRccW9VVCynNBw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
