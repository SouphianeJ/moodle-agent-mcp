# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+9ZumntE79GCb3wyL2oC4NvkLSOy3CL47R8KbLi9D2E=' 'sha256-1aZnQFTktajXV/3d+fpMErhiTmXZSEpbniFHZxLq7vA=' 'sha256-3OlVnZT3mRMS78+CGTSKyyJnyR6m83aodCcNXedXYpM=' 'sha256-3oYl5C/2nMEWEjOoQjIQf5pocw0ZSnbjzO7Gegil06c=' 'sha256-4TwKr+9zFhwto8mlAyCf85ylhdbEhS/OYmzhIsmDWiU=' 'sha256-9TL8pxiPpxge8sVyWHwoLuTLK7fu4TJb05pr6VubJbo=' 'sha256-B7JbxEmPIPTQ1DEOvSx/BKVaAihDEs7Ys4RgId1g5G8=' 'sha256-FZ9oGLKTifP17KKyQcbeS6nbJnVKXmi50uNRpIwcxZo=' 'sha256-JtnRlFC/Zr4IYhUWO4U1aaTm3kcoGWvl/mFamLxLGo8=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-Rrz3LFPKgK0KfjAC2298mzo+NEt0XyvrrTQHqK5cBJE=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-VHr4zNgftwZeyQYrmmj+iFCB1HdggkqI7ZAoA7yYKMU=' 'sha256-WFLhAXHwOUl/ygZ+VAHkHuQ3jQp65zSv1wow+FAq8lc=' 'sha256-WUmhihSdWLwp01eJ2XCjgSqvJ8OT5t6WHoQQZhQtRv8=' 'sha256-bgtSUO0+qBoJrsugEce2e+/r7M1XFLiDO1e6cNAkCPQ=' 'sha256-fRyT/i7aiYcZg0duisKdhSWM6GreH48eyEkmXtYSqQg=' 'sha256-hlxQzEHdDbTb9c4sFHP52kibHQLdzHVf0jACmZp5LCg=' 'sha256-hy3JSaXGG2WZNj7MrKZc87ko1V+J9WItkyTOhYIosBE=' 'sha256-ihTeto63ec3FafqZbKa+wAtEkct1f4/EB8CdnQwL8gc=' 'sha256-mjJSAkw2NiO0/vIpZXbWkhP166JYb4+m/7AByzDxlf4=' 'sha256-oVMulFu4US8hWwpddjW9rLAFZANGmXlgm4ihKKuHXzo=' 'sha256-rRG36LTgm4YcBBNf0B0XLWwSZq2pvRHQUDVDNFDzuhg=' 'sha256-vyhgTiX0+WUk+0+6UWmKFHUkefUpBDJFswZzx6d2VOQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
