# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-0+X3QYRqpjyrF50VHkf7y7bnrLf2NPSC0H8m5QgBvhM=' 'sha256-2gyCin2zPK39BUiuWnxtT1QiSpLkI9OV1I27pSKGqVg=' 'sha256-312mXTMr50f6aWjBcXDgYsLQMoCmLx3sbk4F+zoQVNg=' 'sha256-8v41RadthxV2XgWGuoKLSSmylh2Ldprc4EsxH6eNigI=' 'sha256-Cljf26L6psW5mwMP6K2BlfcSlTh1TPtz5gh/uqBLfEc=' 'sha256-GeRbX2f2FmJOUAOzrJx4cGdMN3OOWJI9chGdEFE46vY=' 'sha256-KNtzQlnqfYnefLP2XAppkYFVsnxIAiu/p2bvj1TdnGQ=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-N6e2/iIFLWsTJrf/ivIFC0TaAvrbFxKoSFaZ+dANI58=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-QUrWWQgQBpFGpW9IOQZbl+ny3aTTmyCWAPx1fkDLwbI=' 'sha256-QmzKv+hVpicqJvILMlPRrCWdBz2UxG6ySLlk2Zq0qMw=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-Vv6n3IT8j/yjTDx8hpdLSF/ADGjZxkyxOIUv0hK8mf8=' 'sha256-gfusePssbbIsNsMy/uYjqHCDTZE7gnhlQVVbN3xljIg=' 'sha256-i11hRDLJDPEzrEyPUYYFrkN2vY4iJg1SMUvWP0bofJE=' 'sha256-isL2lixC9EWFs/yZcbi+7dRAgjjQxX5TQ85tkLpjnX4=' 'sha256-jIrEMlUpq2Mnvry+wE/Ba6WyX4FD2JJIkdFA6BYj/dY=' 'sha256-jKdP+0QgAp7t6NjRkLxTRQn9Td1lkkg/vjT+YqagrJE=' 'sha256-jcKqraKZhDWN9ZWcNIA02DZzIuEF63zuGILNv0oSQxg=' 'sha256-oNAI0M9winE9zqfo0t5kB2470YfEKoG9uJ+tAHIROy8=' 'sha256-rtCRV7s3F+8utel7LTRAsnu+IHjPbCCCFIqzGb/YiQI=' 'sha256-vPaKtpxEz26HBYovXFElCLhQ6yg3A+0zQZULYMQMtz8=' 'sha256-yF1gTaj6i120NT55NvLWQJKl3aC0ZxFClfNvGsWBWAU=' 'sha256-ykTuzkjU9FE0ioO51rekdufDq0ir7k2PBURwlL1e3bo='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
