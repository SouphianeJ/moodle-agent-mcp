# Site block for the Moodle Agent MCP website (static export of site/).
# To be included in the main Caddyfile by the server administrator, e.g. `import /path/to/Caddyfile.site`.
# The served folder is a symlink switched by deploy/deploy.sh; adjust the path to your layout.

moodle-mcp.petits-detours.fr {
	root * /srv/moodle-agent-mcp/current

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The CSP lists the SHA-256 of every inline script of the export (Next.js bootstrap, theme script) instead of
		# 'unsafe-inline'. The list depends on the content of the pages: regenerate it with `node scripts/csp-hashes.mjs --write`
		# after each build that changes a page (CI fails on a missing hash), and reload Caddy before switching `current`.
		# style-src keeps 'unsafe-inline': the pages carry style="" attributes, which only that keyword allows.
		# Nothing is loaded from another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-5CuTru2qWcAXT7dHF0YiobmRkhYKdZ38A/JHwrrV1gg=' 'sha256-6YCjv4UQB4hYAbx14yxZsQiBuXCLs53g52jH8qloe+I=' 'sha256-93YdofXdAM0bFjXFnvTdDf2kQPveLZbanRjh1phydBo=' 'sha256-DdJCgOFH8zfpQ2iDD27MpWUxuGkvR5+Ieu3r/n+NbTY=' 'sha256-DnbNY0NA+Jp+Ct2Dfe+v3W4rbBRd3BE304ir7vFtULU=' 'sha256-G6NV5cRAWkC7vyCF8CaVKXwdKij6y4G0rc/16Ox0ORk=' 'sha256-Ko5NZspC97UZlPmu2ff2jVy8rbF/Lp58XQH2iXPfNr0=' 'sha256-LSJLqrkN6B3wzk1ww/8cDbpNYfwtAk/7VPnqztOqOyY=' 'sha256-Ln7e7Oy0ytsAzWSHcIxByTzqM9k9DhiUaqbwVugAjK8=' 'sha256-MjLN3xhfGUt6M5VBT87pT4QvAt9NcRiuArS9HyBQrCQ=' 'sha256-N3HX6ETzFH8hTAqM65NcTnwWHizoYrTiS4t4xQKw5Tw=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-PyXUnpdWr0FO2a3a7SBDoH49PZesvHNzGB4E8xjKf20=' 'sha256-R1SvQTcV7VWHwMxT3yVw3YP4iKmMXXeymWn04YXp2B0=' 'sha256-SPCKtJb7vbkE0oGUlUkbSW9lKlfV2+hrafPs14RM2sA=' 'sha256-ZlsKhzsKz+L7xiodkL6AceC0m+9LWMjg/+LupDWaQbc=' 'sha256-ghoN/X/Aw6r+sdffUyNMy+08jhEJbvmbnvFOKDH+xfE=' 'sha256-iOjyr16baksau2XrlXAMWF0mWMGGU2CDlVohG8D7dMc=' 'sha256-iXrlWi/iEAuBjNWwaGQ3FTVqhi5cFpAXwYoX+MyC0Ew=' 'sha256-kbpcSKTbGUOZnYjHjL7m/H/sU3bKPpLlETjZE99mtiU=' 'sha256-ohAdF0PDHACF+uvpVq/l4eiKu4VFetzpM7wrYH8jvHQ=' 'sha256-pWSfgcW71o2Zk4pCQpy8XhG6q2QEyEYptFEpGeKZR4M=' 'sha256-tzqS5/2xgNBFu1aBKLLv7WOy6yZ1x0jMisgtRc815zA=' 'sha256-u4fP9hzoD0wsdLrGenGusy5JL8JAq/unu4CbwAxhYFw=' 'sha256-uTwl1Syj3WpCZBR5xdyxtsLVdcvU3YYVstGQB7S5zZo='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Outside the header block: a block with a deferred operation (-Server) is applied only to the responses that the
	# handlers write, and the 404 of handle_errors lost every security header.
	header -Server

	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages and the other files: revalidate.
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# The site lives under /fr/ and /en/.
	redir / /fr/ 302

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/missing/index.html
		rewrite * /fr/missing/index.html
		file_server
	}
}
